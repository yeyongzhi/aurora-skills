# 统一 LF，避免 shell 脚本被转成 CRLF 后在 Linux/macOS 上执行失败
* text=auto eol=lf

# PowerShell 脚本保留 CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制不参与转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff2 binary
